@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var kullaniciAdi = Context.Session.GetString("KullaniciAdi") ?? "Misafir";
    var rol = Context.Session.GetString("Rol") ?? "Oturum yok";
    var oturumVarMi = Context.Session.GetString("KimlikToken") is not null;

    string AktifSinif(string hedefController)
        => string.Equals(controller, hedefController, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Envanter Takip</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnvanterTakip.MvcClient.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar" aria-label="Ana menü">
            <div class="sidebar-brand">
                <div class="brand-mark">IT</div>
                <div>
                    <div class="brand-title">Envanter Takip</div>
                    <div class="brand-subtitle">Mikroservis Paneli</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @AktifSinif("Home")" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span>Kontrol Paneli</span>
                </a>
                <a class="sidebar-link @AktifSinif("Envanter")" asp-area="" asp-controller="Envanter" asp-action="Index">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <span>Envanter</span>
                </a>
                <a class="sidebar-link @AktifSinif("Zimmet")" asp-area="" asp-controller="Zimmet" asp-action="Index">
                    <span class="material-symbols-outlined">assignment_ind</span>
                    <span>Zimmetler</span>
                </a>
                <a class="sidebar-link @AktifSinif("Denetim")" asp-area="" asp-controller="Denetim" asp-action="Index">
                    <span class="material-symbols-outlined">fact_check</span>
                    <span>Denetim</span>
                </a>
            </nav>

            <div class="sidebar-section">
                <div class="sidebar-section-title">API Swagger</div>
                <a class="sidebar-link sidebar-link-muted" href="http://localhost:5000/swagger" target="_blank" rel="noopener">
                    <span class="material-symbols-outlined">key</span>
                    <span>Kimlik API</span>
                </a>
                <a class="sidebar-link sidebar-link-muted" href="http://localhost:5001/swagger" target="_blank" rel="noopener">
                    <span class="material-symbols-outlined">devices</span>
                    <span>Envanter API</span>
                </a>
                <a class="sidebar-link sidebar-link-muted" href="http://localhost:5002/swagger" target="_blank" rel="noopener">
                    <span class="material-symbols-outlined">assignment_return</span>
                    <span>Zimmet API</span>
                </a>
                <a class="sidebar-link sidebar-link-muted" href="http://localhost:5003/swagger" target="_blank" rel="noopener">
                    <span class="material-symbols-outlined">history</span>
                    <span>Denetim API</span>
                </a>
                <a class="sidebar-link sidebar-link-muted" href="http://localhost:5004/swagger" target="_blank" rel="noopener">
                    <span class="material-symbols-outlined">notifications</span>
                    <span>Bildirim API</span>
                </a>
            </div>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                Faz 9 + Mail Test Akışı
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="icon-button d-lg-none" type="button" id="sidebarToggle" aria-label="Menüyü aç">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                    <div class="topbar-search">
                        <span class="material-symbols-outlined">search</span>
                        <input type="search" placeholder="Personel, cihaz veya zimmet ara..." aria-label="Genel arama" />
                    </div>
                </div>

                <div class="topbar-actions">
                    <div id="bildirimMerkezi" class="bildirim-merkezi dropdown d-none">
                        <button class="icon-button notification-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Bildirimler">
                            <span class="material-symbols-outlined">notifications</span>
                            <span id="bildirimSayaci" class="notification-badge d-none">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end bildirim-menusu p-0">
                            <div class="notification-header">Kritik stok bildirimleri</div>
                            <div id="bildirimListesi" class="bildirim-listesi">
                                <div class="text-muted small px-3 py-3">Henüz canlı bildirim yok.</div>
                            </div>
                        </div>
                    </div>

                    <div class="user-chip">
                        <div class="user-avatar">@kullaniciAdi[..1].ToUpperInvariant()</div>
                        <div class="user-meta">
                            <div class="user-name">@kullaniciAdi</div>
                            <div class="user-role">@rol</div>
                        </div>
                    </div>

                    @if (oturumVarMi)
                    {
                        <a asp-controller="Home" asp-action="Cikis" class="btn btn-ghost btn-sm">Çıkış</a>
                    }
                </div>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="bildirim-toast-container" id="bildirimToastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/bildirimler.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
