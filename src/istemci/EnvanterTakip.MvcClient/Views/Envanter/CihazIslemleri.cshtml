@model CihazIslemleriSayfaModel
@{
    ViewData["Title"] = "Cihaz İşlemleri";
    var cihazDurumHareketNedenleri = Enum.GetValues<StokHareketNedeniModel>()
        .Where(neden => neden != StokHareketNedeniModel.EnvantereGiris);
}

<div class="py-3">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Cihaz İşlemleri</h1>
            <p class="text-muted mb-0">@Model.Form.Ad için bilgi güncelle ve cihaz durum hareketi işle.</p>
        </div>
        <a asp-action="Index" asp-route-sekme="cihaz" class="btn btn-outline-secondary">Cihazlara Dön</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.BasariMesaji))
    {
        <div class="alert alert-success" role="alert">@Model.BasariMesaji</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.HataMesaji))
    {
        <div class="alert alert-danger" role="alert">@Model.HataMesaji</div>
    }

    <div class="row g-4">
        <div class="col-xl-8">
            <form asp-action="CihazGuncelle" method="post" class="border rounded-2 p-3">
                <input type="hidden" name="Id" value="@Model.Form.Id" />
                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <h2 class="h6 mb-0">Cihaz Bilgileri</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge text-bg-@(Model.Form.AktifMi ? "success" : "secondary")">@(Model.Form.AktifMi ? "Aktif" : "Pasif")</span>
                        <span class="badge text-bg-@(Model.Form.ToplamVarligaDahilMi ? "primary" : "secondary")">@(Model.Form.ToplamVarligaDahilMi ? "Toplam Varlığa Dahil" : "Toplam Varlık Dışı")</span>
                    </div>
                </div>
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Ad</label>
                        <input name="Ad" class="form-control" value="@Model.Form.Ad" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Marka</label>
                        <input name="Marka" class="form-control" value="@Model.Form.Marka" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Model</label>
                        <input name="Model" class="form-control" value="@Model.Form.Model" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Seri No</label>
                        <input name="SeriNumarasi" class="form-control" value="@Model.Form.SeriNumarasi" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Asset Tag</label>
                        <input type="hidden" name="AssetTag" value="@Model.Form.AssetTag" />
                        <div class="form-control bg-light">@(Model.Form.AssetTag ?? "-")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Kategori</label>
                        <select name="KategoriId" class="form-select">
                            @foreach (var kategori in Model.Kategoriler)
                            {
                                <option value="@kategori.Id" selected="@(kategori.Id == Model.Form.KategoriId ? "selected" : null)">@kategori.Ad</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Lokasyon</label>
                        <select name="LokasyonId" class="form-select">
                            @foreach (var lokasyon in Model.Lokasyonlar)
                            {
                                <option value="@lokasyon.Id" selected="@(lokasyon.Id == Model.Form.LokasyonId ? "selected" : null)">@lokasyon.Ad</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Durum</label>
                        <div class="form-control bg-light">@Model.Form.Durum</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Giriş Tarihi</label>
                        <input name="EnvantereGirisTarihi" type="date" class="form-control" value="@(Model.Form.EnvantereGirisTarihi.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Çıkış Tarihi</label>
                        <div class="form-control bg-light">@(Model.Form.EnvanterdenCikisTarihi?.ToString("dd.MM.yyyy") ?? "-")</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Elden Çıkarma</label>
                        <div class="form-control bg-light">@Model.Form.EldenCikarmaTipi</div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Satılan Kişi veya Kurum</label>
                        <div class="form-control bg-light">@(Model.Form.SatilanKisiVeyaKurum ?? "-")</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Elden Çıkarma Açıklaması</label>
                        <div class="form-control bg-light" style="min-height: 6rem; white-space: pre-wrap;">@(Model.Form.EldenCikarmaAciklamasi ?? "-")</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button class="btn btn-primary" type="submit">Bilgileri Kaydet</button>
                </div>
            </form>
        </div>

        <div class="col-xl-4">
            <form asp-action="CihazDurumHareketi" method="post" class="border rounded-2 p-3">
                <input type="hidden" name="Id" value="@Model.Form.Id" />
                <h2 class="h6 mb-3">Cihaz Durum Hareketi</h2>
                <div class="mb-3">
                    <label class="form-label">Neden</label>
                    <select name="Neden" class="form-select">
                        @foreach (var neden in cihazDurumHareketNedenleri)
                        {
                            <option value="@neden" selected="@(neden == Model.DurumHareketi.Neden ? "selected" : null)">@neden</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Elden Çıkarma</label>
                    <select name="EldenCikarmaTipi" class="form-select">
                        @foreach (var tip in Enum.GetValues<EldenCikarmaTipiModel>())
                        {
                            <option value="@tip" selected="@(tip == Model.DurumHareketi.EldenCikarmaTipi ? "selected" : null)">@tip</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Satılan Kişi veya Kurum</label>
                    <input name="SatilanKisiVeyaKurum" class="form-control" value="@Model.DurumHareketi.SatilanKisiVeyaKurum" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Açıklama</label>
                    <textarea name="Aciklama" class="form-control" rows="4">@Model.DurumHareketi.Aciklama</textarea>
                </div>
                <button class="btn btn-primary w-100" type="submit">Durum Hareketi İşle</button>
            </form>
        </div>
    </div>

    <div class="border rounded-2 p-3 mt-4">
        <h2 class="h6 mb-3">Cihaz Durum Geçmişi</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Neden</th>
                        <th>Açıklama</th>
                        <th>İşlemi Yapan</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DurumHareketleri.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-muted">Cihaz durum hareketi bulunamadı.</td>
                        </tr>
                    }
                    @foreach (var hareket in Model.DurumHareketleri)
                    {
                        <tr>
                            <td>@hareket.OlusturulmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@hareket.Neden</td>
                            <td>@(hareket.Aciklama ?? "-")</td>
                            <td>@hareket.OlusturanKullaniciId</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
