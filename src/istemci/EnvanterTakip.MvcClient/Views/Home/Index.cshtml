@model KimlikPersonelPanelModel
@{
    ViewData["Title"] = "Kontrol Paneli";
    var kullaniciPersonelIdleri = Model.Kullanicilar.Select(kullanici => kullanici.PersonelId).ToHashSet();
    var hesapAcilabilirPersoneller = Model.Personeller
        .Where(personel => personel.AktifMi && personel.Durum != PersonelDurumuModel.IstenAyrildi && !kullaniciPersonelIdleri.Contains(personel.Id))
        .ToList();
    var aktifPersoneller = Model.Personeller
        .Where(personel => personel.AktifMi && personel.Durum != PersonelDurumuModel.IstenAyrildi)
        .ToList();
    var departmanAktif = Model.AktifSekme == "departman";
    var personelAktif = Model.AktifSekme == "personel";
    var kullaniciAktif = Model.AktifSekme == "kullanici";
}

<div>
    <div class="page-header">
        <div>
            <h1 class="page-title">Personel ve Departman</h1>
            <p class="page-subtitle">Departman, personel, kullanıcı ve oturum akışını yönet.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-ghost" href="http://localhost:5000/swagger" target="_blank" rel="noopener">Swagger</a>
            <a class="btn btn-ghost" href="http://localhost:5000/saglik" target="_blank" rel="noopener">Servis Durumu</a>
        </div>
    </div>

    @await Html.PartialAsync("_Mesajlar", (Model.BasariMesaji, Model.HataMesaji, (IReadOnlyCollection<string>)Model.ListelemeHatalari))

    <section class="panel-card mb-4">
        <div class="panel-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-7">
                    <h2 class="h5 mb-2">Oturum</h2>
                    @if (Model.OturumKullanici is null)
                    {
                        <p class="text-muted mb-0">Henüz giriş yapılmadı.</p>
                    }
                    else
                    {
                        <dl class="row mb-0 small">
                            <dt class="col-sm-3">Kullanıcı</dt>
                            <dd class="col-sm-9">@Model.OturumKullanici.KullaniciAdi</dd>
                            <dt class="col-sm-3">Rol</dt>
                            <dd class="col-sm-9">@Model.OturumKullanici.Rol</dd>
                            <dt class="col-sm-3">PersonelId</dt>
                            <dd class="col-sm-9 font-monospace">@Model.OturumKullanici.PersonelId</dd>
                        </dl>
                    }
                </div>
                <div class="col-lg-5">
                    @if (Model.OturumKullanici is null)
                    {
                        <form asp-action="Giris" method="post" class="row g-2">
                            <div class="col-sm-5">
                                <label class="form-label">Kullanıcı adı</label>
                                <input name="KullaniciAdi" class="form-control" value="admin" />
                            </div>
                            <div class="col-sm-5">
                                <label class="form-label">Şifre</label>
                                <input name="Sifre" type="password" class="form-control" value="Admin123!" />
                            </div>
                            <div class="col-sm-2 d-grid">
                                <button class="btn btn-primary" type="submit">Giriş</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <a asp-action="Cikis" class="btn btn-outline-danger">Çıkış Yap</a>
                    }
                </div>
            </div>
        </div>
    </section>

    <div class="metric-grid">
        <div class="metric-card">
            <div class="d-flex justify-content-between align-items-start">
                <div class="metric-label">Departman</div>
                <div class="metric-icon"><span class="material-symbols-outlined">domain</span></div>
            </div>
            <div class="metric-value">@Model.Departmanlar.Count</div>
        </div>
        <div class="metric-card">
            <div class="d-flex justify-content-between align-items-start">
                <div class="metric-label">Personel</div>
                <div class="metric-icon"><span class="material-symbols-outlined">groups</span></div>
            </div>
            <div class="metric-value">@Model.Personeller.Count</div>
        </div>
        <div class="metric-card">
            <div class="d-flex justify-content-between align-items-start">
                <div class="metric-label">Kullanıcı</div>
                <div class="metric-icon"><span class="material-symbols-outlined">manage_accounts</span></div>
            </div>
            <div class="metric-value">@Model.Kullanicilar.Count</div>
        </div>
    </div>

    <div class="panel-card">
        <ul class="nav nav-tabs modern-tabs" id="kimlikPersonelSekmeleri" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(departmanAktif ? "active" : "")" id="departman-tab" data-bs-toggle="tab" data-bs-target="#departman" type="button" role="tab">Departmanlar</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(personelAktif ? "active" : "")" id="personel-tab" data-bs-toggle="tab" data-bs-target="#personel" type="button" role="tab">Personeller</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(kullaniciAktif ? "active" : "")" id="kullanici-tab" data-bs-toggle="tab" data-bs-target="#kullanici" type="button" role="tab">Kullanıcılar</button>
            </li>
        </ul>

        <div class="tab-content tab-content-modern">
            <div class="tab-pane fade @(departmanAktif ? "show active" : "")" id="departman" role="tabpanel" aria-labelledby="departman-tab">
                <div class="row g-4">
                    <div class="col-xl-8">
                        <div class="table-responsive">
                            <table class="table table-modern align-middle">
                                <thead>
                                    <tr>
                                        <th>Departman</th>
                                        <th>Sorumlu</th>
                                        <th>Durum</th>
                                        <th class="text-end">Güncelle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var departman in Model.Departmanlar)
                                    {
                                        <tr>
                                            <td colspan="4">
                                                <form asp-action="DepartmanGuncelle" method="post" class="row g-2 align-items-end">
                                                    <input type="hidden" name="Id" value="@departman.Id" />
                                                    <div class="col-md-4">
                                                        <label class="form-label small">Departman adı</label>
                                                        <input name="Ad" class="form-control form-control-sm" value="@departman.Ad" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small">Sorumlu</label>
                                                        <select name="SorumluPersonelId" class="form-select form-select-sm">
                                                            <option value="">Seçilmedi</option>
                                                            @foreach (var personel in Model.Personeller.Where(personel => personel.AktifMi || personel.Id == departman.SorumluPersonelId))
                                                            {
                                                                <option value="@personel.Id" selected="@(personel.Id == departman.SorumluPersonelId ? "selected" : null)">@personel.Ad @personel.Soyad</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-check">
                                                            <input name="AktifMi" value="true" class="form-check-input" type="checkbox" checked="@departman.AktifMi" />
                                                            <input type="hidden" name="AktifMi" value="false" />
                                                            <label class="form-check-label small">Aktif</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2 d-grid">
                                                        <button class="btn btn-sm btn-primary" type="submit">Kaydet</button>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <form asp-action="DepartmanOlustur" method="post" class="form-card">
                            <h3 class="h6 mb-3">Departman oluştur</h3>
                            <div class="mb-3">
                                <label class="form-label">Ad</label>
                                <input name="Ad" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Sorumlu</label>
                                <select name="SorumluPersonelId" class="form-select">
                                    <option value="">Seçilmedi</option>
                                    @foreach (var personel in aktifPersoneller)
                                    {
                                        <option value="@personel.Id">@personel.Ad @personel.Soyad</option>
                                    }
                                </select>
                            </div>
                            <button class="btn btn-primary w-100" type="submit">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade @(personelAktif ? "show active" : "")" id="personel" role="tabpanel" aria-labelledby="personel-tab">
                <div class="row g-4">
                    <div class="col-xl-8">
                        <form asp-action="Index" method="get" class="panel-card mb-3">
                            <div class="panel-card-body row g-2 align-items-end">
                                <input type="hidden" name="sekme" value="personel" />
                                <div class="col-md-5">
                                    <label class="form-label">Personel ara</label>
                                    <input name="personelArama" class="form-control" value="@Model.PersonelArama" placeholder="Ad, soyad veya e-posta" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Departman</label>
                                    <select name="personelDepartmanId" class="form-select">
                                        <option value="">Tüm departmanlar</option>
                                        @foreach (var departman in Model.Departmanlar)
                                        {
                                            <option value="@departman.Id" selected="@(departman.Id == Model.PersonelDepartmanId ? "selected" : null)">@departman.Ad</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 d-grid gap-2">
                                    <button class="btn btn-primary" type="submit">Filtrele</button>
                                    <a asp-action="Index" asp-route-sekme="personel" class="btn btn-ghost">Temizle</a>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-modern align-middle">
                                <thead>
                                    <tr>
                                        <th>Ad Soyad</th>
                                        <th>Departman</th>
                                        <th>Sorumlu</th>
                                        <th>Aktif</th>
                                        <th>E-posta</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.FiltreliPersoneller.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="text-muted">Filtreye uygun personel bulunamadı.</td>
                                        </tr>
                                    }
                                    @foreach (var personel in Model.FiltreliPersoneller)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@personel.Ad @personel.Soyad</td>
                                            <td>@DepartmanAdi(personel.DepartmanId)</td>
                                            <td>@(personel.DepartmanSorumlusuMu ? "Evet" : "Hayır")</td>
                                            <td><span class="status-badge @(personel.AktifMi ? "success" : "danger")">@(personel.AktifMi ? "Aktif" : "Pasif")</span></td>
                                            <td>@personel.Email</td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="PersonelDuzenle" asp-route-id="@personel.Id" class="btn btn-outline-primary">Düzenle</a>
                                                    @if (personel.Durum != PersonelDurumuModel.IstenAyrildi)
                                                    {
                                                        <a asp-action="PersonelIstenAyrilOnay" asp-route-id="@personel.Id" class="btn btn-outline-danger">İşten ayrıldı yap</a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <form asp-action="PersonelOlustur" method="post" class="form-card">
                            <h3 class="h6 mb-3">Personel oluştur</h3>
                            <div class="row g-2">
                                <div class="col-sm-6"><label class="form-label">Ad</label><input name="Ad" class="form-control" /></div>
                                <div class="col-sm-6"><label class="form-label">Soyad</label><input name="Soyad" class="form-control" /></div>
                                <div class="col-12"><label class="form-label">E-posta</label><input name="Email" type="email" class="form-control" /></div>
                                <div class="col-12">
                                    <label class="form-label">Departman</label>
                                    <select name="DepartmanId" class="form-select">
                                        @foreach (var departman in Model.Departmanlar.Where(departman => departman.AktifMi))
                                        {
                                            <option value="@departman.Id">@departman.Ad</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-6"><label class="form-label">Unvan</label><input name="Unvan" class="form-control" /></div>
                                <div class="col-sm-6"><label class="form-label">İşe giriş</label><input name="IseGirisTarihi" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input name="DepartmanSorumlusuMu" value="true" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label">Departman sorumlusu</label>
                                    </div>
                                </div>
                            </div>
                            <button class="btn btn-primary w-100 mt-3" type="submit">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade @(kullaniciAktif ? "show active" : "")" id="kullanici" role="tabpanel" aria-labelledby="kullanici-tab">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="table-responsive">
                            <table class="table table-modern align-middle">
                                <thead>
                                    <tr>
                                        <th>Kullanıcı adı</th>
                                        <th>Rol</th>
                                        <th>Personel</th>
                                        <th>Durum</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kullanici in Model.Kullanicilar)
                                    {
                                        var personel = Model.Personeller.FirstOrDefault(personel => personel.Id == kullanici.PersonelId);
                                        <tr>
                                            <td class="fw-semibold">@kullanici.KullaniciAdi</td>
                                            <td>@kullanici.Rol</td>
                                            <td>@(personel is null ? "-" : $"{personel.Ad} {personel.Soyad}")</td>
                                            <td><span class="status-badge @(kullanici.AktifMi ? "success" : "danger")">@(kullanici.AktifMi ? "Aktif" : "Pasif")</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <form asp-action="KullaniciOlustur" method="post" class="form-card">
                            <h3 class="h6 mb-3">Kullanıcı oluştur</h3>
                            <div class="mb-3">
                                <label class="form-label">Personel</label>
                                <select name="PersonelId" class="form-select">
                                    @foreach (var personel in hesapAcilabilirPersoneller)
                                    {
                                        <option value="@personel.Id">@personel.Ad @personel.Soyad</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3"><label class="form-label">Kullanıcı adı</label><input name="KullaniciAdi" class="form-control" /></div>
                            <div class="mb-3"><label class="form-label">Şifre</label><input name="Sifre" type="password" class="form-control" /></div>
                            <div class="mb-3">
                                <label class="form-label">Rol</label>
                                <select name="Rol" class="form-select">
                                    <option value="Admin">Admin</option>
                                    <option value="ITPersoneli">ITPersoneli</option>
                                    <option value="PersonelKullanicisi" selected>PersonelKullanicisi</option>
                                </select>
                            </div>
                            <button class="btn btn-primary w-100" type="submit" disabled="@(hesapAcilabilirPersoneller.Count == 0)">Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string DepartmanAdi(Guid id)
        => Model.Departmanlar.FirstOrDefault(departman => departman.Id == id)?.Ad ?? "-";
}
