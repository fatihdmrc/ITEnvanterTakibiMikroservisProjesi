@model PersonelDuzenleSayfaModel
@{
    ViewData["Title"] = "Personel Düzenle";
}

<div class="py-3">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Personel Düzenle</h1>
            <p class="text-muted mb-0">@Model.Form.Ad @Model.Form.Soyad kaydını güncelle.</p>
        </div>
        <a asp-action="Index" asp-route-sekme="personel" class="btn btn-outline-secondary">Personellere Dön</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.HataMesaji))
    {
        <div class="alert alert-danger" role="alert">@Model.HataMesaji</div>
    }

    <form asp-action="PersonelDuzenle" method="post" class="border rounded-2 p-3">
        <input type="hidden" asp-for="Form.Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Form.Ad" class="form-label">Ad</label>
                <input asp-for="Form.Ad" class="form-control" />
                <span asp-validation-for="Form.Ad" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Form.Soyad" class="form-label">Soyad</label>
                <input asp-for="Form.Soyad" class="form-control" />
                <span asp-validation-for="Form.Soyad" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Form.Email" class="form-label">E-posta</label>
                <input asp-for="Form.Email" type="email" class="form-control" />
                <span asp-validation-for="Form.Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Form.Unvan" class="form-label">Unvan</label>
                <input asp-for="Form.Unvan" class="form-control" />
                <span asp-validation-for="Form.Unvan" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Form.DepartmanId" class="form-label">Departman</label>
                <select asp-for="Form.DepartmanId" class="form-select">
                    @foreach (var departman in Model.Departmanlar)
                    {
                        <option value="@departman.Id">@departman.Ad</option>
                    }
                </select>
                <span asp-validation-for="Form.DepartmanId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Form.Durum" class="form-label">Durum</label>
                <select asp-for="Form.Durum" class="form-select">
                    @foreach (var durum in Enum.GetValues<PersonelDurumuModel>())
                    {
                        <option value="@durum">@durum</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input name="Form.DepartmanSorumlusuMu" value="true" class="form-check-input" type="checkbox" checked="@Model.Form.DepartmanSorumlusuMu" />
                    <input type="hidden" name="Form.DepartmanSorumlusuMu" value="false" />
                    <label class="form-check-label">Departman sorumlusu</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input name="Form.AktifMi" value="true" class="form-check-input" type="checkbox" checked="@Model.Form.AktifMi" />
                    <input type="hidden" name="Form.AktifMi" value="false" />
                    <label class="form-check-label">Aktif</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" asp-route-sekme="personel" class="btn btn-outline-secondary">Vazgeç</a>
            <button class="btn btn-primary" type="submit">Kaydet</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
