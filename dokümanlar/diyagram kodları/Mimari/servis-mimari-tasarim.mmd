flowchart LR
    Kullanici[Admin / ITPersoneli / PersonelKullanicisi]

    subgraph GatewayKatmani["Api Gateway Katmanı"]
        ApiGateway[ApiGateway<br/>YARP Reverse Proxy]
    end

    subgraph Servisler["Mikroservisler"]
        KimlikVePersonelServisi[KimlikVePersonelServisi]
        EnvanterServisi[EnvanterServisi]
        ZimmetServisi[ZimmetServisi]
        DenetimKaydiServisi[DenetimKaydiServisi]
        BildirimServisi[BildirimServisi]
    end

    subgraph VeriDepolari["Veri Depoları"]
        KimlikDb[(PostgreSQL<br/>Kimlik ve Personel DB)]
        EnvanterDb[(PostgreSQL<br/>Envanter DB)]
        ZimmetDb[(PostgreSQL<br/>Zimmet DB)]
        MongoDB[(MongoDB<br/>Audit Log)]
        Redis[(Redis<br/>Kategori / Lokasyon Cache)]
    end

    subgraph EventAltyapisi["Event Altyapısı"]
        Cap[DotNetCore.CAP<br/>Publish / Subscribe]
        RabbitMQ[(RabbitMQ<br/>inventory.events)]
        OutboxKimlik[(CAP Outbox<br/>Kimlik DB)]
        OutboxEnvanter[(CAP Outbox<br/>Envanter DB)]
        OutboxZimmet[(CAP Outbox<br/>Zimmet DB)]
    end

    subgraph GercekZamanli["Gerçek Zamanlı Bildirim"]
        SignalR[SignalR<br/>NotificationHub]
    end

    Kullanici -- "HTTPS / JWT" --> ApiGateway

    ApiGateway -- "Login, personel, departman" --> KimlikVePersonelServisi
    ApiGateway -- "Cihaz, stok, kategori, lokasyon" --> EnvanterServisi
    ApiGateway -- "Zimmet ve iade" --> ZimmetServisi
    ApiGateway -- "Audit sorguları" --> DenetimKaydiServisi
    ApiGateway -- "Kritik stok bildirimi izleme" --> BildirimServisi

    KimlikVePersonelServisi --> KimlikDb
    EnvanterServisi --> EnvanterDb
    ZimmetServisi --> ZimmetDb
    DenetimKaydiServisi --> MongoDB
    EnvanterServisi -- "Kategori / lokasyon cache" --> Redis

    ZimmetServisi -- "HTTP: personel aktif mi?" --> KimlikVePersonelServisi
    ZimmetServisi -- "HTTP: cihaz uygun mu?" --> EnvanterServisi
    ZimmetServisi -- "HTTP: cihaz durumu güncelle" --> EnvanterServisi

    KimlikVePersonelServisi -- "personel.isten-ayrildi" --> OutboxKimlik
    EnvanterServisi -- "cihaz.durumu-degisti<br/>stok.kritik-seviyeye-dusuldu" --> OutboxEnvanter
    ZimmetServisi -- "zimmet.olusturuldu<br/>zimmet.iade-alindi<br/>cihaz.kontrole-alindi<br/>zimmet.iade-edildi" --> OutboxZimmet

    OutboxKimlik --> Cap
    OutboxEnvanter --> Cap
    OutboxZimmet --> Cap
    Cap --> RabbitMQ

    RabbitMQ -- "Tüm eventler" --> DenetimKaydiServisi
    RabbitMQ -- "stok.kritik-seviyeye-dusuldu" --> BildirimServisi
    RabbitMQ -. "personel.isten-ayrildi<br/>gelecek consumer" .-> ZimmetServisi

    BildirimServisi --> SignalR
    SignalR -- "Sadece kritik stok bildirimi" --> Kullanici

