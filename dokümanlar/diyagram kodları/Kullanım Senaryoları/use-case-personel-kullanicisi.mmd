flowchart LR
    %% Personel Kullanıcısı aktörü için use-case diyagramı

    Personel([Personel Kullanıcısı])

    subgraph Sistem["IT Ekipman Takip Sistemi"]
        direction TB

        subgraph Hesap["Hesap ve Profil"]
            direction TB
            UC_Giris(("Sisteme giriş yap"))
            UC_Profil(("Kendi profil bilgisini görüntüle"))
        end

        subgraph ZimmetTakip["Kendi Zimmet Süreçlerini Takip"]
            direction TB
            UC_Aktif(("Kendi aktif zimmetlerini görüntüle"))
            UC_Gecmis(("Kendi zimmet geçmişini görüntüle"))
            UC_IadeDurum(("Kendi iade süreci durumunu takip et"))
            UC_Detay(("Zimmet detayını görüntüle"))
            UC_Foto(("Zimmet ve iade fotoğraflarını görüntüle"))
        end
    end

    Personel --> UC_Giris
    Personel --> UC_Profil
    Personel --> UC_Aktif
    Personel --> UC_Gecmis
    Personel --> UC_IadeDurum

    UC_Aktif -. "detay" .-> UC_Detay
    UC_Gecmis -. "detay" .-> UC_Detay
    UC_IadeDurum -. "detay" .-> UC_Detay
    UC_Detay -. "varsa" .-> UC_Foto

    classDef actor fill:#f8fafc,stroke:#334155,stroke-width:1.6px,color:#0f172a;
    classDef account fill:#eef2ff,stroke:#4f46e5,stroke-width:1.3px,color:#111827;
    classDef self fill:#f0fdfa,stroke:#0d9488,stroke-width:1.3px,color:#111827;

    class Personel actor;
    class UC_Giris,UC_Profil account;
    class UC_Aktif,UC_Gecmis,UC_IadeDurum,UC_Detay,UC_Foto self;
